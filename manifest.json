{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "0.4.1",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "apweb@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["src/shared/i18n.js", "src/shared/ai.js", "src/background.js"]
  },
  "commands": {
    "toggle-selection-trigger": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "__MSG_toggleSelectionShortcut__"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "vendor/marked.umd.js",
        "vendor/purify.min.js",
        "vendor/katex.min.js",
        "src/shared/i18n.js",
        "src/shared/ai.js",
        "src/shared/math.js",
        "src/shared/markdown.js",
        "src/shared/store.js",
        "src/content/panel.js",
        "src/content/content.js"
      ]
    }
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/panel.css", "icons/icon.svg"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["vendor/katex.min.css", "vendor/fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
