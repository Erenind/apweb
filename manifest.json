{
  "manifest_version": 3,
  "name": "网页 AI 助手（划词问答）",
  "version": "0.1.0",
  "description": "把 AI 对话和划词提问带到任意网页。OpenAI 兼容接口，key 只存本机浏览器。",
  "browser_specific_settings": {
    "gecko": {
      "id": "apweb@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["src/shared/ai.js", "src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "vendor/marked.umd.js",
        "vendor/purify.min.js",
        "src/shared/ai.js",
        "src/shared/markdown.js",
        "src/shared/store.js",
        "src/content/panel.js",
        "src/content/content.js"
      ]
    }
  ],
  "action": {
    "default_title": "AI 助手（划词问答）",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "sidebar_action": {
    "default_title": "AI 助手",
    "default_panel": "src/sidebar/sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/panel.css", "icons/icon.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
